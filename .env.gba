# 학교 서버(aiforalab.com/gba/) 배포 전용 설정 — `npm run build:gba` 가 이 파일을 읽는다.
#
# 이 사이트는 두 곳에 배포된다.
#   · Vercel            → api/school-api.js 서버리스 함수  (기본값, VITE_API_BASE 없음)
#   · 학교 서버 Apache   → /globalbiz-api/globalbiz-api.php
# 학교 서버에는 school-api 함수가 없어서, 기본값으로 빌드해 올리면
# 회원가입·로그인·설문·방문로깅이 전부 404 가 된다.
VITE_API_BASE=/globalbiz-api/globalbiz-api.php

# 아바타·음성·채팅 API. 학교 서버는 PHP 포팅본을 /gba/api/ 아래에 둔다.
#   Vercel  : /api/stt          (api/stt.js)
#   학교 서버: /gba/api/stt.php
VITE_API_PREFIX=/gba/api
VITE_API_SUFFIX=.php
